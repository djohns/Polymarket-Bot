# Copiar a .env y completar. Nunca commitear .env real.
# Fase 0: todas estas variables pueden quedar vacías (sólo se usa lectura pública).

# Wallet dedicada del bot (Polygon). Se usa localmente para firmar EIP-712; nunca se envía a Polymarket.
POLYMARKET_PRIVATE_KEY=

# Credenciales L2 del CLOB (se derivan firmando con la private key, no se registran manualmente).
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# RPC Polygon (fallback público: https://polygon-rpc.com)
POLYGON_RPC_URL=

# The Odds API (odds deportivas, free tier)
THE_ODDS_API_KEY=

# Persistencia (Fase 1+). Por defecto SQLite local.
DATABASE_URL=sqlite:///data/polybot.db

# Motor de señales (Fase 1). Todos tienen default razonable si se dejan vacíos.
ARB_THRESHOLD=0.03
LONGSHOT_PRICE_LOW=0.15
LONGSHOT_PRICE_HIGH=0.85
LONGSHOT_CORRECTION=0.05

# Ingesta (Fase 1)
DISCOVERY_INTERVAL_SECONDS=120
DISCOVERY_MARKET_LIMIT=100
OPPORTUNITY_LOG_COOLDOWN_SECONDS=30

# Simulador de ejecución + position sizing (Fase 2). Todos con default razonable.
# Capital base simulado (USD) para el sizing de arb ("fórmula de ganancia garantizada").
ARB_CAPITAL_BASE=1000.0
# Fracción máxima del capital base en una sola posición de arb.
ARB_MAX_FRACTION_PER_TRADE=0.05
# Exposición abierta máxima (fracción del capital base) por mercado individual.
ARB_MAX_EXPOSURE_PER_MARKET=0.10
# Exposición abierta máxima (fracción del capital base) por cluster de eventos correlacionados.
ARB_MAX_EXPOSURE_PER_CLUSTER=0.20
# Fracción de Kelly para señales de edge incierto (no usada hoy por el arb; ver risk/kelly.py).
KELLY_FRACTION=0.25

# Tracking de resolución real + Brier score (Fase 2, parte 2).
# Cada cuánto se consulta CLOB por la resolución de mercados con posiciones abiertas.
RESOLUTION_CHECK_INTERVAL_SECONDS=900
# Días sin resolver tras los que una posición cerrada-sin-ganador se marca "pendiente"
# (posible disputa de oráculo UMA) y se loguea una advertencia.
RESOLUTION_STALE_AFTER_DAYS=7

# Dashboard (Fase 2, parte 3). Reporte HTML estático, regenerado por un systemd timer
# (ver deploy/polymarket-bot-dashboard.*) -- no es un servidor vivo.
DASHBOARD_OUTPUT_PATH=data/dashboard.html

# Ejecución real (Fase 3). CAPITAL REAL -- ver CLAUDE.md sección "Fase 3" y
# docs/deploy.md antes de tocar cualquiera de estas variables.
# Interruptor maestro: en false (default), Fase 3 no se activa aunque el resto
# del setup esté listo. No poner en true sin haber validado el setup completo
# (allowances, kill-switch probado, cifrado de clave) y sin dar luz verde explícita.
REAL_TRADING_ENABLED=false
# Capital real total (USD) dedicado a Fase 3.
REAL_CAPITAL_BASE_USD=20.0
# Exposición real máxima (USD) por mercado individual.
REAL_MAX_EXPOSURE_PER_MARKET_USD=5.0
# Exposición real máxima (USD) por cluster de eventos correlacionados.
REAL_MAX_EXPOSURE_PER_CLUSTER_USD=5.0
# Piso de balance real (USD) bajo el cual el kill-switch automático detiene todo trading real.
REAL_KILL_SWITCH_BALANCE_FLOOR_USD=15.0
# Archivo flag del kill-switch (manual y automático) -- su sola presencia detiene el trading real.
REAL_KILL_SWITCH_FLAG_PATH=data/REAL_TRADING_HALTED
# Ruta al archivo con la private key cifrada (generado con scripts/encrypt_private_key.py).
REAL_ENCRYPTED_KEY_PATH=data/private_key.enc
# Nombre de la variable de entorno (separada de este .env) desde la que se lee la
# passphrase de descifrado en runtime. Ver docs/deploy.md.
REAL_KEY_PASSPHRASE_ENV_VAR=POLYMARKET_KEY_PASSPHRASE
# Cada cuánto se chequea el balance real de USDC para el kill-switch automático.
REAL_BALANCE_CHECK_INTERVAL_SECONDS=300
# Proxy wallet ("Safe Wallet") que Polymarket asigna a tu cuenta -- ahí vive el pUSD
# real, NO en la dirección de tu private key. La ves en polymarket.com bajo tu wallet
# ("dirección de desarrollador" / dirección de depósito) -- nunca le mandes fondos
# directo, sólo vía el flujo de Depósito de la UI. Sin default: es específica de cada
# cuenta. Sin esto configurado, Fase 3 no arranca aunque REAL_TRADING_ENABLED=true.
REAL_FUNDER_ADDRESS=
# Tipo de firma para el signer -- ver CLAUDE.md sección Fase 3 para el detalle completo
# de por qué NO es simplemente el que sugiere la documentación general por tipo de
# cuenta (se verificó empíricamente contra el balance real on-chain de esta cuenta).
# 3 = POLY_1271 (default para esta cuenta, wallet externa/MetaMask con proxy wallet
# implementada como smart contract validado vía EIP-1271). 2 = POLY_GNOSIS_SAFE,
# 1 = POLY_PROXY (Magic Link/email), 0 = EOA sin proxy wallet -- probar y verificar
# contra el balance real si tu cuenta difiere; no asumir por el método de login.
REAL_SIGNATURE_TYPE=3
# Divergencia máxima tolerada (USD) entre el balance real y lo que real_positions
# implica que debería haber, antes de disparar el kill-switch preventivamente
# (ver CLAUDE.md, sección Fase 3, incidente del 2026-09-08).
REAL_RECONCILIATION_THRESHOLD_USD=0.50
# Punto de referencia para la reconciliación: el balance real CONFIRMADO
# (vía get_balance_allowance) al momento REAL_BALANCE_CHECKPOINT_AT, asumiendo
# que ahí real_positions ya reflejaba todo lo sucedido hasta esa fecha. Van
# siempre juntos -- sin la fecha, el monto se ignora. Re-fijar el par después
# de cada backfill/incidente resuelto. Sin esto, la reconciliación usa
# REAL_CAPITAL_BASE_USD como aproximación nominal contra TODAS las posiciones,
# lo cual genera divergencias falsas si el balance real de arranque no
# coincidía exactamente con ese número.
REAL_BALANCE_CHECKPOINT_USD=
REAL_BALANCE_CHECKPOINT_AT=
