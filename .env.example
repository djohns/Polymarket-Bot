# Copiar a .env y completar. Nunca commitear .env real.
# Fase 0: todas estas variables pueden quedar vacías (sólo se usa lectura pública).

# Wallet dedicada del bot (Polygon). Se usa localmente para firmar EIP-712; nunca se envía a Polymarket.
POLYMARKET_PRIVATE_KEY=

# Credenciales L2 del CLOB (se derivan firmando con la private key, no se registran manualmente).
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# RPC Polygon (fallback público: https://polygon-rpc.com)
POLYGON_RPC_URL=

# The Odds API (odds deportivas, free tier)
THE_ODDS_API_KEY=

# Persistencia (Fase 1+). Por defecto SQLite local.
DATABASE_URL=sqlite:///data/polybot.db

# Motor de señales (Fase 1). Todos tienen default razonable si se dejan vacíos.
ARB_THRESHOLD=0.03
LONGSHOT_PRICE_LOW=0.15
LONGSHOT_PRICE_HIGH=0.85
LONGSHOT_CORRECTION=0.05

# Ingesta (Fase 1)
DISCOVERY_INTERVAL_SECONDS=120
DISCOVERY_MARKET_LIMIT=100
OPPORTUNITY_LOG_COOLDOWN_SECONDS=30
