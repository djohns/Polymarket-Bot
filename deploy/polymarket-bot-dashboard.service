[Unit]
Description=Polymarket Bot - regenera el reporte HTML del dashboard (Fase 2, parte 3)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/opt/polymarket-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/polymarket-bot/.venv/bin/python -m polybot.dashboard.report
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/polymarket-bot/data
